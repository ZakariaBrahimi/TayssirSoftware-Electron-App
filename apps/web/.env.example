# Database: local SQLite file (default) or a Turso/libSQL URL for cloud hosting.
DATABASE_URL=file:./data/tayssir.db
# DATABASE_AUTH_TOKEN=

# Required in production: a random string of at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (used by the auth library), e.g. https://pos.example.com
BETTER_AUTH_URL=http://localhost:3000
