# ---------------------------------------------------------------------------
# Deployment mode
#   local: one store per install (desktop app, shop server). First-run setup,
#          offline license, optional sync with a cloud store.  (default)
#   cloud: multi-store SaaS: public sign-up, subscriptions, license server and
#          sync server for desktop installs.
# ---------------------------------------------------------------------------
TAYSSIR_MODE=local

# Database: local SQLite file (default) or a Turso/libSQL URL.
DATABASE_URL=file:./data/tayssir.db
# DATABASE_AUTH_TOKEN=

# Required in production: a random string of at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. https://pos.example.com
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Licensing (generate both keys once with: npm run admin -- keys:generate)
# ---------------------------------------------------------------------------
# Cloud only, keep secret: signs licenses and subscription tokens.
# LICENSE_PRIVATE_KEY=
# Cloud + local: verifies them. Without it, local installs are not licensed
# (no trial, no restrictions), e.g. for your own shop server.
# LICENSE_PUBLIC_KEY=
# Local: where license keys are activated (your cloud deployment).
# LICENSE_SERVER_URL=https://app.example.com

# Local: background sync interval when linked to a cloud store (ms).
# SYNC_INTERVAL_MS=60000
