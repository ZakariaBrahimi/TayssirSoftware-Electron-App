{
  "name": "tayssir",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tayssir/web",
    "build": "npm run build -w @tayssir/web",
    "start": "npm run start -w @tayssir/web",
    "lint": "npm run lint -w @tayssir/web",
    "typecheck": "npm run typecheck -w @tayssir/web",
    "test": "npm run test -w @tayssir/web",
    "db:migrate": "npm run db:migrate -w @tayssir/web",
    "db:seed": "npm run db:seed -w @tayssir/web"
  },
  "engines": {
    "node": ">=20.9"
  }
}
