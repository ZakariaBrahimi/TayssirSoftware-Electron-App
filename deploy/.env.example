# Copy to deploy/.env (install.sh does it for you) and keep it private.

# Public address of the app (DNS A record pointing to this server).
DOMAIN=mizan.example.com
# For Let's Encrypt notices (expiring or failing certificates).
ACME_EMAIL=you@example.com

# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Signing keys for licenses and subscriptions, generated once with
#   docker compose run --rm app node admin.mjs keys:generate
# Never change them afterwards: every issued license would stop working.
# The public key also goes into the desktop builds (GitHub secret).
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# Usernames allowed into the owner console at /platform (comma-separated).
PLATFORM_ADMINS=

# Currency of your subscription prices and payments.
PLATFORM_CURRENCY=DZD

# Optional: also copy the daily backups off this server with rclone
# (configure a remote first with `rclone config`), e.g. b2:my-bucket/mizan
RCLONE_REMOTE=

# Optional: daily stock summaries on Telegram. Create a bot with @BotFather
# and paste its token; the server connects it at start-up.
TELEGRAM_BOT_TOKEN=
# Optional: daily stock summaries by email, through any SMTP service, e.g.
# SMTP_URL=smtps://user:password@smtp-relay.brevo.com:465
SMTP_URL=
MAIL_FROM=Mizan <alerts@yourdomain.com>
